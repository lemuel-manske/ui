{
  "name": "@lkmliz/ui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "description": "UI components for lkmliz projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/ui.git"
  },
  "homepage": "https://github.com/lemuel-manske/ui#readme",
  "bugs": {
    "url": "https://github.com/lemuel-manske/ui/issues"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "precommit": "lint-staged",
    "storybook": "npm run storybook --workspace @lkmliz/components",
    "format": "npm run format --workspaces && prettier --check .",
    "format:fix": "npm run format:fix --workspaces && prettier --write .",
    "lint": "npm run lint --workspaces && eslint .",
    "lint:fix": "npm run lint:fix --workspaces && eslint . --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@lkmliz/config-eslint": "file:packages/config-eslint",
    "@lkmliz/config-prettier": "file:packages/config-prettier",
    "eslint": "9.39.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.6.0"
  }
}
