{
  "name": "@lemuel-manske/ui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "description": "UI components for @Hemuel-manske projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/ui.git"
  },
  "homepage": "https://github.com/lemuel-manske/ui#readme",
  "bugs": {
    "url": "https://github.com/lemuel-manske/ui/issues"
  },
  "engines": {
    "node": "^22.14.0 || >= 24.10.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:docs": "npm run build:reference && node scripts/prepare-docs-site.js && docusaurus build website --out-dir dist && node scripts/package-docs-site.js",
    "build:reference": "npm run build:storybook --workspace @lemuel-manske/components && node scripts/export-agent-docs.js",
    "check:packages": "node scripts/check-packages.js",
    "commitlint": "commitlint",
    "docs": "npm run build:reference && node scripts/prepare-docs-site.js && docusaurus start website --port 3000 --no-open",
    "format": "npm run format --workspaces -- --ignore-path ../../.prettierignore && prettier --check .",
    "format:fix": "npm run format:fix --workspaces -- --ignore-path ../../.prettierignore && prettier --write .",
    "lint": "npm run lint --workspaces && eslint .",
    "lint:fix": "npm run lint:fix --workspaces && eslint . --fix",
    "precommit": "lint-staged",
    "prepare": "husky",
    "release": "semantic-release",
    "storybook": "npm run storybook --workspace @lemuel-manske/components",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@lemuel-manske/config-eslint": "file:packages/config-eslint",
    "@lemuel-manske/config-prettier": "file:packages/config-prettier",
    "@mdx-js/react": "3.1.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "25.0.9",
    "serve-handler": "6.1.8"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.6.0": true
  }
}
