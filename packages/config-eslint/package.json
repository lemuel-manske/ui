{
  "name": "@lkmliz/config-eslint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./node": "./node.js",
    "./react": "./react.js"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --config node.js",
    "lint:fix": "eslint . --config node.js --fix"
  },
  "dependencies": {
    "@eslint/js": "9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.0.0",
    "typescript-eslint": "8.46.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@lkmliz/config-prettier": "file:../config-prettier",
    "prettier": "3.6.0"
  }
}
