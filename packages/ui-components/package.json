{
  "name": "@lemuel-manske/components",
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable React components and static styles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/ui.git",
    "directory": "packages/ui-components"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/components.js"
    },
    "./styles.css": "./dist/components.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:storybook": "storybook build --disable-telemetry",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev --port 6006 --disable-telemetry --no-open",
    "test": "tsc --project tsconfig.storybook.json && playwright test --tsconfig ../../tsconfig.test.json"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@lemuel-manske/design-tokens": "^0.1.0",
    "@lemuel-manske/utils": "^0.1.0"
  },
  "devDependencies": {
    "@lemuel-manske/config-eslint": "file:../config-eslint",
    "@lemuel-manske/config-playwright": "file:../config-playwright",
    "@lemuel-manske/config-prettier": "file:../config-prettier",
    "@lemuel-manske/config-typescript": "file:../config-typescript",
    "@lemuel-manske/config-vite": "file:../config-vite",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "prettier": "3.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.6",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  }
}
