{
  "name": "@lkmliz/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed design tokens, shared enums, and build-time theme CSS.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@lkmliz/config-eslint": "file:../config-eslint",
    "@lkmliz/config-prettier": "file:../config-prettier",
    "@lkmliz/config-typescript": "file:../config-typescript",
    "@lkmliz/config-vite": "file:../config-vite",
    "@types/node": "22.15.0",
    "eslint": "9.39.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  }
}
