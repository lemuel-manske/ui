{
  "name": "@lemuel-manske/design-tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed design tokens, shared enums, and build-time theme CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/ui.git",
    "directory": "packages/ui-design-tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc --project tsconfig.tests.json && jest"
  },
  "devDependencies": {
    "@lemuel-manske/config-eslint": "file:../config-eslint",
    "@lemuel-manske/config-jest": "file:../config-jest",
    "@lemuel-manske/config-prettier": "file:../config-prettier",
    "@lemuel-manske/config-typescript": "file:../config-typescript",
    "@lemuel-manske/config-vite": "file:../config-vite",
    "@types/node": "22.15.0",
    "eslint": "10.14.0",
    "prettier": "3.6.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  }
}
