{
  "name": "@lemuel-manske/utils",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared frontend utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemuel-manske/ui.git",
    "directory": "packages/ui-utils"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc --project tsconfig.tests.json && jest && playwright test --tsconfig ../../tsconfig.test.json"
  },
  "devDependencies": {
    "@lemuel-manske/config-eslint": "file:../config-eslint",
    "@lemuel-manske/config-jest": "file:../config-jest",
    "@lemuel-manske/config-playwright": "file:../config-playwright",
    "@lemuel-manske/config-prettier": "file:../config-prettier",
    "@lemuel-manske/config-typescript": "file:../config-typescript",
    "@lemuel-manske/config-vite": "file:../config-vite",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.0",
    "prettier": "3.6.0",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
